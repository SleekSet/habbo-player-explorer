<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Habbo Player Explorer</title>
<style>
:root{font-family:system-ui,Arial,sans-serif;color-scheme:dark;background:#0d1526;color:#f2f6ff}*{box-sizing:border-box}body{margin:0}main{max-width:1050px;margin:auto;padding:20px 14px}.panel{background:#18243a;border:1px solid #34445d;border-radius:18px;padding:18px;margin:16px 0}h1{margin:10px 0}p,.muted{color:#b8c5d8}form,.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}input,select,button{padding:13px;border-radius:11px;border:1px solid #52617b;font:inherit}input{flex:1;min-width:160px;background:#0d1526;color:white}select{background:#0d1526;color:white}button{background:#f9cb44;color:#162238;border:0;font-weight:750;cursor:pointer}button:disabled{opacity:.55}.secondary{background:#33445d;color:white}.hero{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.avatar{height:150px;width:110px;object-fit:contain;image-rendering:pixelated;background:#24344d;border-radius:14px}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tabs button{background:#293951;color:white}.tabs button.active{background:#f9cb44;color:#162238}.cards,.friend-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}.item,.friend-card{background:#24344d;border-radius:12px;padding:12px;overflow-wrap:anywhere}.item img{max-height:65px;max-width:75px;object-fit:contain;image-rendering:pixelated}.item strong{display:block;margin:6px 0}.friend-card{display:flex;gap:10px;align-items:center}.friend-card img{width:55px;height:90px;object-fit:contain;image-rendering:pixelated}.meta{min-width:0;overflow-wrap:anywhere}.meta button{padding:7px;font-size:12px;margin:5px 3px 0 0}.status{display:inline-block;border-radius:20px;padding:5px 10px;background:#33445d}.good{background:#145a45}.subtle{font-size:13px;color:#b8c5d8}a{color:#ffdb6c}#error{color:#ffb3b3;white-space:pre-wrap}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.statusdot.on{color:#6ae5ac}[hidden]{display:none!important}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #f9cb44;outline-offset:2px}@media(max-width:540px){main{padding:14px 11px}.panel{padding:15px}.hero{justify-content:center;text-align:center}.tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.tabs button{padding:10px 5px;font-size:13px}}
</style></head><body><main>
<h1>🏨 Habbo Player Explorer <small class="subtle">V4.1</small></h1><p>Explore publicly visible player profiles, friends, badges, groups and owned rooms.</p>
<section class="panel"><form id="search"><input id="username" placeholder="Habbo username" aria-label="Habbo username" required><select id="hotel" aria-label="Hotel"><option value="www.habbo.com">International .com</option><option value="www.habbo.com.br">Brazil</option><option value="www.habbo.de">Germany</option><option value="www.habbo.es">Spain</option><option value="www.habbo.fi">Finland</option><option value="www.habbo.fr">France</option><option value="www.habbo.it">Italy</option><option value="www.habbo.nl">Netherlands</option><option value="www.habbo.com.tr">Turkey</option></select><button id="go" type="submit">Search player</button></form><p id="error" role="alert" aria-live="polite"></p><p class="subtle">API relay setup: paste your deployed Cloudflare Worker URL below and tap Save. This is required when Habbo blocks direct browser requests.</p><div class="toolbar"><input id="relay" placeholder="https://your-worker.workers.dev" aria-label="API relay URL"><button id="saveRelay" type="button" class="secondary">Save relay</button></div><p id="relayStatus" class="subtle" aria-live="polite"></p></section>
<section class="panel"><div class="section-head"><div><h2>⭐ Favourite players</h2><p class="subtle">Saved in this browser. Status is checked when requested.</p></div><div class="toolbar"><button id="refresh" class="secondary" type="button">↻ Refresh</button><select id="refreshRate" aria-label="Auto refresh"><option value="0">Auto refresh off</option><option value="60000">Every minute</option><option value="300000">Every 5 minutes</option></select></div></div><p id="watchStatus" class="subtle" aria-live="polite"></p><div id="watchList" class="friend-grid"></div></section>
<section id="results" hidden><div class="panel hero"><img id="avatar" class="avatar" alt="Habbo avatar"><div><h2 id="displayName"></h2><button type="button" id="saveFav" class="secondary">☆ Add to favourites</button><p id="motto"></p><span id="online" class="status"></span><p id="details"></p></div></div><div class="panel"><div class="tabs" id="tabs"></div><p id="count" class="muted"></p><div class="toolbar"><input id="filter" placeholder="Filter visible results" aria-label="Filter results"><button id="export" type="button" class="secondary">Export public data</button></div><div id="content" class="cards" style="margin-top:12px"></div></div></section>
<p class="subtle">Unofficial fan utility, not affiliated with Habbo. Private profiles may hide information. The public API cannot reveal which room a player is currently in. Favourites are stored only in this browser.</p>
</main><script>
'use strict';
const $=id=>document.getElementById(id);
const labels={friends:'Friends',badges:'Badges',groups:'Groups',rooms:'Owned rooms',achievements:'Achievements'};
const storageKey='habbo-explorer-favorites-v2';
let data={},tab='friends',currentUser=null,refreshTimer=null,refreshBusy=false;
function node(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=String(text);if(cls)n.className=cls;return n}
function error(message){$('error').textContent=message}
function relayUrl(){return (localStorage.getItem('habbo-relay-url')||'').trim().replace(/\/$/,'')}
function apiUrl(hotel,path){const relay=relayUrl();return relay?relay+'/?hotel='+encodeURIComponent(hotel)+'&path='+encodeURIComponent(path):'https://'+hotel+'/api/public'+path}
async function api(hotel,path){let response;try{response=await fetch(apiUrl(hotel,path),{headers:{Accept:'application/json'},signal:AbortSignal.timeout(15000)})}catch(e){throw new Error('API connection failed. '+(relayUrl()?'Check that your Cloudflare Worker URL is correct and deployed. ':'Set up and save the Cloudflare Worker relay URL first. ')+e.message)}if(!response.ok){let detail='';try{const body=await response.json();detail=body.error?' ('+body.error+')':''}catch{}throw new Error('Habbo API returned HTTP '+response.status+' for '+path+detail)}return response.json()}
$('relay').value=relayUrl();
$('relayStatus').textContent=relayUrl()?'Relay URL saved. Ready to test.':'Relay not configured yet.';
$('saveRelay').addEventListener('click',()=>{const value=$('relay').value.trim().replace(/\/$/,'');try{const url=new URL(value);if(url.protocol!=='https:'||url.username||url.password||url.search||url.hash)throw Error();localStorage.setItem('habbo-relay-url',value);$('relayStatus').textContent='Relay saved. Now search a player.'}catch{$('relayStatus').textContent='Enter a valid HTTPS Worker URL, such as https://example.workers.dev'}});
function avatarUrl(figure,hotel){return 'https://'+hotel+'/habbo-imaging/avatarimage?figure='+encodeURIComponent(figure||'')+'&size=l&direction=2&head_direction=2&action=std'}
function avatarByName(name,hotel){return 'https://'+hotel+'/habbo-imaging/avatarimage?user='+encodeURIComponent(name)+'&size=m&direction=2&head_direction=2'}
function date(s){if(!s)return 'Not available';const d=new Date(s);return Number.isNaN(d.getTime())?String(s):d.toLocaleDateString()}
function favorites(){try{const x=JSON.parse(localStorage.getItem(storageKey)||'[]');return Array.isArray(x)?x:[]}catch{return []}}
function saveFavorites(x){try{localStorage.setItem(storageKey,JSON.stringify(x))}catch{$('watchStatus').textContent='Could not save favourites: browser storage unavailable.'}}
function isSaved(u){return favorites().some(x=>x.hotel===u.hotel&&x.name.toLowerCase()===u.name.toLowerCase())}
function updateFavButton(){$('saveFav').textContent=currentUser&&isSaved(currentUser)?'★ Remove favourite':'☆ Add to favourites'}
function renderFavorites(){const list=$('watchList');list.replaceChildren();const saved=favorites();if(!saved.length){list.append(node('p','No favourites yet. Search a player and tap Add to favourites.','muted'));return}for(const u of saved){const card=node('div',undefined,'friend-card'),img=node('img'),meta=node('div',undefined,'meta');img.src=avatarByName(u.name,u.hotel);img.alt='Avatar';img.loading='lazy';img.dataset.avatar=u.hotel+'|'+u.name.toLowerCase();meta.append(node('strong',u.name),node('div',u.hotel,'subtle'));const status=node('div','Not checked','statusdot');status.dataset.status=u.hotel+'|'+u.name.toLowerCase();meta.append(status);const view=node('button','View','secondary');view.type='button';view.onclick=()=>{$('username').value=u.name;$('hotel').value=u.hotel;$('search').requestSubmit();window.scrollTo({top:0,behavior:'smooth'})};const remove=node('button','Remove','secondary');remove.type='button';remove.onclick=()=>{saveFavorites(favorites().filter(x=>!(x.hotel===u.hotel&&x.name.toLowerCase()===u.name.toLowerCase())));renderFavorites()};meta.append(view,remove);card.append(img,meta);list.append(card)}}
function draw(){const tabs=$('tabs');tabs.replaceChildren();for(const k of Object.keys(labels)){const b=node('button',labels[k]+(Array.isArray(data[k])?' ('+data[k].length+')':''));b.type='button';if(k===tab)b.className='active';b.onclick=()=>{tab=k;draw()};tabs.append(b)}const items=data[tab],content=$('content');content.replaceChildren();$('count').textContent=items===undefined?'Loading…':items===null?'Not available (private, unsupported or API error)':items.length+' public '+labels[tab].toLowerCase();if(!Array.isArray(items))return;for(const v of items){const card=node('div',undefined,'item');if(v.figureString){const img=node('img');img.src=avatarUrl(v.figureString,$('hotel').value);img.alt='Avatar';img.loading='lazy';card.append(img)}else if(v.code&&tab==='badges'){const img=node('img');img.src='https://images.habbo.com/c_images/album1584/'+encodeURIComponent(v.code)+'.gif';img.alt='Badge';img.loading='lazy';card.append(img)}card.append(node('strong',v.name||v.code||v.title||v.id||'Entry'));if(v.motto||v.description)card.append(node('div',v.motto||v.description,'muted'));if(tab==='friends'&&v.name){const b=node('button','View profile');b.type='button';b.onclick=()=>{$('username').value=v.name;$('search').requestSubmit();window.scrollTo({top:0,behavior:'smooth'})};card.append(b)}if(card.textContent.toLowerCase().includes($('filter').value.toLowerCase()))content.append(card)}}
$('filter').addEventListener('input',draw);
$('search').addEventListener('submit',async e=>{e.preventDefault();const hotel=$('hotel').value,name=$('username').value.trim();if(!name)return;if(!relayUrl()){error('Set up the Cloudflare Worker relay and tap Save relay first.');return}$('go').disabled=true;$('results').hidden=true;currentUser=null;error('Searching…');try{const user=await api(hotel,'/users?name='+encodeURIComponent(name));if(!user||!user.uniqueId)throw new Error('No public player profile was returned.');currentUser={name:user.name||name,hotel};$('displayName').textContent=currentUser.name;$('motto').textContent=user.motto||'No motto';$('avatar').src=user.figureString?avatarUrl(user.figureString,hotel):avatarByName(currentUser.name,hotel);$('online').textContent=user.online===true?'Online':user.online===false?'Offline':'Status unavailable';$('online').className='status'+(user.online===true?' good':'');$('details').textContent='Joined: '+date(user.memberSince)+' · Last online: '+date(user.lastAccessTime||user.lastOnline)+' · Level: '+(user.currentLevel??'N/A');updateFavButton();$('results').hidden=false;error('');$('filter').value='';data=Object.fromEntries(Object.keys(labels).map(k=>[k,undefined]));tab='friends';draw();const id=encodeURIComponent(user.uniqueId);await Promise.all(Object.keys(labels).map(async k=>{try{const result=await api(hotel,'/users/'+id+'/'+k);data[k]=Array.isArray(result)?result:Array.isArray(result?.[k])?result[k]:Array.isArray(result?.achievements)?result.achievements:null}catch{data[k]=null}draw()}))}catch(err){error(err.message)}finally{$('go').disabled=false}});
$('saveFav').addEventListener('click',()=>{if(!currentUser)return;let saved=favorites();if(isSaved(currentUser))saved=saved.filter(x=>!(x.hotel===currentUser.hotel&&x.name.toLowerCase()===currentUser.name.toLowerCase()));else saved.push({...currentUser});saveFavorites(saved);updateFavButton();renderFavorites()});
async function refreshFavorites(){if(refreshBusy)return;refreshBusy=true;$('refresh').disabled=true;const saved=favorites();$('watchStatus').textContent=saved.length?'Checking '+saved.length+' saved player(s)…':'Save players to start tracking.';let reached=0;try{await Promise.all(saved.map(async u=>{const key=u.hotel+'|'+u.name.toLowerCase();const status=Array.from(document.querySelectorAll('[data-status]')).find(n=>n.dataset.status===key);try{const info=await api(u.hotel,'/users?name='+encodeURIComponent(u.name));reached++;if(status){status.textContent=info.online===true?'● Online':info.online===false?'● Offline':'Status hidden';status.className='statusdot'+(info.online===true?' on':'')}const img=Array.from(document.querySelectorAll('[data-avatar]')).find(n=>n.dataset.avatar===key);if(img&&info.figureString)img.src=avatarUrl(info.figureString,u.hotel)}catch{if(status)status.textContent='Unavailable (API/network)'}}));$('watchStatus').textContent=saved.length?'Updated '+new Date().toLocaleTimeString()+' · '+reached+'/'+saved.length+' profiles reached':'Save players to start tracking.'}finally{refreshBusy=false;$('refresh').disabled=false}}
$('refresh').addEventListener('click',refreshFavorites);
$('refreshRate').addEventListener('change',()=>{if(refreshTimer)clearInterval(refreshTimer);const ms=Number($('refreshRate').value);if(ms)refreshTimer=setInterval(()=>{if(!document.hidden)refreshFavorites()},ms)});
$('export').addEventListener('click',()=>{if(!currentUser)return;const blob=new Blob([JSON.stringify({player:currentUser,exportedAt:new Date().toISOString(),publicData:data},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=node('a');a.href=url;a.download='habbo-'+currentUser.name.replace(/[^a-z0-9_-]/gi,'_')+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});
renderFavorites();
</script></body></html>
